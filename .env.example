# Bắt buộc
DISCORD_TOKEN=your-discord-bot-token

# Trên Railway (và PaaS khác) khai báo biến trong dashboard, không cần file .env.
# Khi đó đặt DATABASE_PATH=/data/musicbot.sqlite3 và gắn volume tại /data.

# Tùy chọn chung
COMMAND_PREFIX=m!
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Dùng khi YouTube chặn IP máy chủ (định dạng Netscape cookies.txt)
YTDLP_COOKIES_FILE=
# Railway: đổi thành /data/musicbot.sqlite3 (volume gắn tại /data)
DATABASE_PATH=data/musicbot.sqlite3
LOG_LEVEL=INFO

# Phát nhạc
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
MAX_PLAYLIST_SIZE=50
QUEUE_PAGE_SIZE=10
EMBED_COLOR=#5865F2
YTDLP_TIMEOUT_SECONDS=45
STREAM_TIMEOUT_SECONDS=30
RECONNECT_MAX_DELAY_SECONDS=60

# Chỉ dùng khi phát triển: đồng bộ slash command vào một server cụ thể
DEV_GUILD_ID=

# Last.fm scrobbling (một tài khoản cho toàn bot)
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_SESSION_KEY=
LASTFM_USERNAME=

# Spotify metadata (Client ID + Client Secret, không phải user token)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
